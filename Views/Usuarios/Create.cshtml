@model AsistenciaGR.Models.Usuarios

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Usuarios</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="UsApellido" class="control-label"></label>
                <input asp-for="UsApellido" class="form-control" />
                <span asp-validation-for="UsApellido" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UsNombre" class="control-label"></label>
                <input asp-for="UsNombre" class="form-control" />
                <span asp-validation-for="UsNombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UsDNI" class="control-label"></label>
                <input asp-for="UsDNI" class="form-control" />
                <span asp-validation-for="UsDNI" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RoId" class="control-label"></label>
                <select asp-for="RoId" class="form-control" asp-items="@(ViewData["RoId"] as SelectList)">
                    <option value="">-- Seleccione un rol --</option>
                </select>
                <span asp-validation-for="RoId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
