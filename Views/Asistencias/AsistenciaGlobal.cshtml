@model AsistenciaGR.Models.AsistenciaGlobalViewModel

@{
    ViewData["Title"] = "Asistencia Global";
}

<div class="container-fluid px-4 py-3">

    @if (Model.CaMaId == null)
    {
        <p class="text-muted">Seleccione una materia para ver la asistencia global.</p>
    }
    else
    {
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>ALUMNOS</th>
                    @foreach (var fecha in Model.Fechas)
                    {
                        <th>@fecha.ToString("d/M/...")</th>
                    }
                    <th class="text-end">%</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td><strong>@row.FullName</strong></td>
                        @foreach (var fecha in Model.Fechas)
                        {
                            <td>
                                @if (row.AsistenciaPorFecha.TryGetValue(fecha, out bool presente))
                                {
                                    @(presente ? "✅" : "❌")
                                }
                            </td>
                        }
                        <td class="text-end fw-bold">@row.PorcentajeAsistencia%</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>