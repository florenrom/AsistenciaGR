@model AsistenciaGR.Models.Asistencia

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Asistencia</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="AsId" />
            <div class="form-group">
                <label asp-for="AsFecha" class="control-label"></label>
                <input asp-for="AsFecha" class="form-control" />
                <span asp-validation-for="AsFecha" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="AsPresente" /> @Html.DisplayNameFor(model => model.AsPresente)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="AsJustificacion" /> @Html.DisplayNameFor(model => model.AsJustificacion)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="UsId" class="control-label"></label>
                <input asp-for="UsId" class="form-control" />
                <span asp-validation-for="UsId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaId" class="control-label"></label>
                <input asp-for="MaId" class="form-control" />
                <span asp-validation-for="MaId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
