@model AsistenciaGR.Models.Carreras_Materias

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Carreras_Materias</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="CaId" class="control-label"></label>
                <select asp-for="CaId" class="form-control" asp-items="@(ViewData["CaId"] as SelectList)">
                    <option value="">-- Seleccione una carrera --</option>
                </select>
                <span asp-validation-for="CaId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Carreras" class="control-label"></label>
                <input asp-for="Carreras" class="form-control" />
                <span asp-validation-for="Carreras" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaId" class="control-label"></label>
                <select asp-for="MaId" class="form-control" asp-items="@(ViewData["MaId"] as SelectList)">
                    <option value="">-- Seleccione una materia --</option>
                </select>
                <span asp-validation-for="MaId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Materias" class="control-label"></label>
                <input asp-for="Materias" class="form-control" />
                <span asp-validation-for="Materias" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CaMaDenominacion" class="control-label"></label>
                <input asp-for="CaMaDenominacion" class="form-control" />
                <span asp-validation-for="CaMaDenominacion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Inscripciones" class="control-label"></label>
                <input asp-for="Inscripciones" class="form-control" />
                <span asp-validation-for="Inscripciones" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
