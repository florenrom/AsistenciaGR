@model IEnumerable<AsistenciaGR.Models.Inscripciones>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UsId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CaMaId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Usuarios)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Carreras_Materias)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.UsId)
            </td>
            <td>
                @Html.DisplayFor(model => item.CaMaId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Usuarios)
            </td>
            <td>
                @Html.DisplayFor(model => item.Carreras_Materias)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.InId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.InId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.InId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
