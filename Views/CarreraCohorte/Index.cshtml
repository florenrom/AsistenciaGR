@model IEnumerable<AsistenciaGR.Models.CarreraCohorte>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CaId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CoId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Carrera)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cohorte)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.CaId)
            </td>
            <td>
                @Html.DisplayFor(model => item.CoId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Carrera)
            </td>
            <td>
                @Html.DisplayFor(model => item.Cohorte)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CaCoId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CaCoId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.CaCoId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
